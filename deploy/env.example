# /etc/fraudvae/env - the public site's settings. install.sh writes this from deploy/env.example;
# edit here and `systemctl restart fraudvae`.

# public mode: no training, no data build, no remote routes, no visitor state, rate limits on
FRAUDVAE_PUBLIC=1

# the generation that scores when a request names none (the newest, best one)
FRAUDVAE_RUN=v7-f
# keep every generation resident so a comparison across all of them never waits for a load
FRAUDVAE_MAX_LOADED=8
FRAUDVAE_PRELOAD=milestones

# where the bundles were pulled to and where the app keeps its (read-only) state
FRAUDVAE_RUNS_DIR=/srv/fraudvae/runs
FRAUDVAE_DATA_DIR=/srv/fraudvae/app/data
FRAUDVAE_HOME=/srv/fraudvae/home
FRAUDVAE_SERVER_LOG=/srv/fraudvae/home/server.log

# bind to localhost only; nginx is the public face
FRAUDVAE_HOST=127.0.0.1
FRAUDVAE_PORT=8765

# per-visitor limits inside the app (nginx has its own, coarser, in front)
FRAUDVAE_SCORE_PER_MINUTE=60
FRAUDVAE_SCORE_BURST=20
FRAUDVAE_BATCH_PER_MINUTE=4
FRAUDVAE_BATCH_ROWS=5000
FRAUDVAE_BATCH_CONCURRENCY=2
# generations one request may compare: every one on the timeline
FRAUDVAE_COMPARE_MAX=8
# the v6 / v7 transaction encoder, about a thirtieth of a second per event it reads on this kind of cpu:
# rows of one file it may read, the earlier payments of one history it reads like any score, and how many
# more of them cost one more request (those longer histories also run one at a time, all visitors together)
FRAUDVAE_ENCODER_BATCH_ROWS=1000
FRAUDVAE_ENCODER_HISTORY_FREE=8
FRAUDVAE_ENCODER_HISTORY_PER_TOKEN=16
# transactions scoring at the same time, all visitors together; past it a request gets 503 and a Retry-After
FRAUDVAE_SCORE_CONCURRENCY=4
# whose X-Real-IP / X-Forwarded-For the buckets believe: loopback (this box's nginx) always; add a
# load balancer's address here if one terminates connections in front of nginx
# FRAUDVAE_TRUSTED_PROXIES=

# cpu threads for torch / lightgbm: leave two of the six cores for nginx and the kernel
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
