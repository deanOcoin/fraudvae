# copy to .env and edit. everything is optional, the defaults work for a local checkout

# where raw downloads live (kaggle zips go here as-is)
FRAUDVAE_RAW_DIR=data/raw
# processed/prepared outputs
FRAUDVAE_DATA_DIR=data
# training runs
FRAUDVAE_RUNS_DIR=runs
# app state: generated ssh key, remembered hosts, known_hosts
FRAUDVAE_HOME=~/.fraudvae
# the server's startup / crash log (defaults to $FRAUDVAE_HOME/server.log)
# FRAUDVAE_SERVER_LOG=server.log

# web ui
FRAUDVAE_HOST=127.0.0.1
FRAUDVAE_PORT=8765

# optional: kaggle api credentials so `fraudvae fetch` can pull the kaggle sets itself
# KAGGLE_USERNAME=
# KAGGLE_KEY=
